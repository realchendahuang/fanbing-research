{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "predictions dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "claim_text",
      "made_on",
      "horizon",
      "test_rule",
      "source_ids",
      "status",
      "assessment",
      "outcome_source_ids"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^PR\\d{3,}$"
      },
      "claim_text": {
        "type": "string",
        "minLength": 1
      },
      "made_on": {
        "type": "string",
        "pattern": "^\\d{4}(?:-\\d{2})?(?:-\\d{2})?$"
      },
      "horizon": {
        "type": "string",
        "minLength": 1
      },
      "test_rule": {
        "type": "string",
        "minLength": 1
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^S\\d{3,}$"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "status": {
        "type": "string",
        "enum": [
          "unassessed",
          "pending",
          "supported",
          "not_supported",
          "indeterminate"
        ]
      },
      "assessment": {
        "type": [
          "string",
          "null"
        ]
      },
      "outcome_source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^S\\d{3,}$"
        },
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}
