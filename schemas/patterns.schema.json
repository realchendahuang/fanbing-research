{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "patterns dataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "status",
      "claim_ids",
      "counter_claim_ids",
      "source_ids",
      "case_family_count",
      "confidence",
      "falsifier",
      "limitations",
      "path"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^P\\d{3,}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "working_hypothesis",
          "revised",
          "withdrawn"
        ]
      },
      "claim_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^C\\d{3,}$"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "counter_claim_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^C\\d{3,}$"
        },
        "minItems": 0,
        "uniqueItems": true
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^S\\d{3,}$"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "case_family_count": {
        "type": "integer",
        "minimum": 1
      },
      "confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "falsifier": {
        "type": "string",
        "minLength": 1
      },
      "limitations": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "pattern": "^research/patterns/[A-Za-z0-9_.\\-/]+\\.md$"
      }
    },
    "additionalProperties": false
  }
}
